# Application
APP_ENV=development
APP_DEBUG=false
ENABLE_API_DOCS=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
# "*" allows any Host header (needed for FastAPI Cloud / preview URLs).
# For stricter production, set a comma-separated list of hostnames.
TRUSTED_HOSTS=*

# Cookies (use Secure=true in production behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_NAME=pai_refresh_token
CSRF_COOKIE_NAME=pai_csrf_token

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Redirect URLs (must match Supabase → Authentication → URL Configuration → Redirect URLs)
# Use dedicated frontend callback pages — never the site root and never this API.
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:3000/auth/verify-email
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password
FRONTEND_ONBOARDING_PATH=/onboarding
FRONTEND_HOME_PATH=/

AUTH_HTTP_TIMEOUT_SECONDS=10.0

# PostgreSQL — use async driver for the app (password: URL-encode special chars @ < > etc.)
# Supabase: Dashboard → Project Settings → Database → Connection string (URI)
# Example (Session pooler, IPv4-friendly on Windows — user is postgres.your-project-ref):
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL_VERIFY=false


# Fernet key for sensitive vault fields (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VAULT_ENCRYPTION_KEY=replace-with-generated-fernet-key

# LLM: OpenAI Responses for text; separate vision provider for OCR
LLM_DEFAULT_PROVIDER=openai
LLM_COUNSELING_MODEL=gpt-5.6-terra
LLM_EXTRACTION_MODEL=gpt-5.6-luna
LLM_DOCUMENT_MODEL=gpt-5.6-luna
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# Phase 3 — documents (Supabase Storage bucket, private)
SUPABASE_STORAGE_BUCKET=documents
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=180
DOCUMENT_ALLOW_IMAGE_UPLOADS=true
DOCUMENT_OCR_PROVIDER=openai_vision
DOCUMENT_VISION_MAX_PAGES=20
DOCUMENT_VISION_BATCH_PAGES=2
DOCUMENT_VISION_MAX_TOKENS=8000
DOCUMENT_MALWARE_SCAN_PROVIDER=none
LLM_DOCUMENT_VISION_MODEL=gpt-4o-mini
ENABLE_DOCUMENT_WORKER=true
ENABLE_INTELLIGENCE_WORKER=true
CHAT_RECENT_MESSAGE_LIMIT=20

# Tavily web search (add your key — leave empty to disable live search gracefully)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# AgentSpan memory + counselor tool loop
SEMANTIC_MEMORY_MAX_RESULTS=5
CONVERSATION_MEMORY_MAX_MESSAGES=40
ENABLE_COUNSELOR_TOOLS=true
COUNSELOR_MAX_TOOL_ROUNDS=1

# Responses reasoning/output budgets (output includes a reasoning reserve)
LLM_COUNSELING_MAX_TOKENS=2048
LLM_COUNSELING_TIMEOUT_SECONDS=30
LLM_SIMPLE_COUNSELING_MODEL=gpt-5.6-luna
LLM_GOAL_MODEL=gpt-5.6-terra
LLM_COMPLEX_MODEL=gpt-5.6-sol
LLM_COUNSELING_REASONING=low
LLM_EXTRACTION_REASONING=none
LLM_GOAL_REASONING=medium
# Opt in after comparing quality on representative goals.
ENABLE_INTEGRATED_GOAL_ANALYSIS=false
ENABLE_GOAL_ESCALATION=true
# Run separate worker processes in production (see docs/latency-openai.md).
RUN_WORKERS_IN_API=false
ENABLE_GOAL_WORKER=true

# Realtime budgets (seconds, including network work)
MEMORY_RECALL_BUDGET_SECONDS=4.0
TURN_UNDERSTANDING_BUDGET_SECONDS=2.0
EMBEDDING_TIMEOUT_SECONDS=3.0

# Optional neural reranking endpoint (leave blank to use vector relevance)
MEMORY_RERANK_URL=
MEMORY_RERANK_API_KEY=
MEMORY_RERANK_MODEL=
MEMORY_RERANK_BUDGET_SECONDS=0.2

# Shared request and conservative model usage reservations
ENABLE_RATE_LIMITS=true
# Keep the API available if the counter table or database connection is temporarily unavailable.
# Readiness and logs still expose the failure. Set true only when blocking is required.
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_BACKEND_TIMEOUT_SECONDS=2.5
REQUEST_LIMIT_PER_MINUTE=120
USER_REQUEST_LIMIT_PER_MINUTE=60
UPLOAD_LIMIT_PER_DAY=30
LLM_CALL_LIMIT_PER_DAY=300
LLM_TOKEN_LIMIT_PER_DAY=1000000
LLM_GLOBAL_TOKEN_LIMIT_PER_DAY=10000000
READINESS_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_MAX_AGE_SECONDS=600
WORKER_QUEUE_MAX_AGE_SECONDS=900
